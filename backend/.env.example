# Copy this file to .env and update the local absolute path.
# Required only when uploading or analyzing DWG files. DXF files do not need it.
ODA_FILE_CONVERTER=C:\\Path\\To\\ODAFileConverter.exe

# Optional vision configuration. Keep disabled unless the configured model accepts images.
DRAWING_VLM_ENABLED=false

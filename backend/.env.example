# Copy this file to .env and update the local absolute path.
# Required only when uploading or analyzing DWG files. DXF files do not need it.
ODA_FILE_CONVERTER=C:\\Program Files\\ODA\\ODAFileConverter 27.1.0ODAFileConverter.exe

# Optional Direct-DWG route. When true, every DWG is opened by a custom
# Autodesk RealDWG-backed sidecar instead of ODA File Converter. AutoCAD and
# the RealDWG SDK do not provide this sidecar executable; it must be built and
# deployed separately. The command accepts input-DWG and output-DXF paths as
# its last two arguments.
DRAWING_USE_REALDWG=false
REALDWG_PARSER_COMMAND=

# Optional vision configuration. Keep disabled unless the configured model accepts images.
DRAWING_VLM_ENABLED=true
DRAWING_VLM_USE_EXCEL_REFERENCES=true
DRAWING_VLM_REFERENCE_LIMIT=4
DRAWING_VLM_TIMEOUT_SECONDS=60
# Kimi K3 accepts this OpenAI-compatible extension. Set false for providers
# that reject an unknown `thinking` field.
DRAWING_VLM_DISABLE_THINKING=true
# Font file name available in the local system font cache. Applied to all DXF
# text styles only while producing PNG renderings; set empty to preserve styles.
DRAWING_RENDER_TEXT_FONT=simhei.ttf
# High-resolution rasterization used only by per-region VLM/OBB inference.
DRAWING_VISION_DPI=450
# Required when VLM is enabled: a model that supports image_url / image input.
# Do not point this to a text-only chat model.
# Some providers require a fixed temperature. The tested TokenHub Kimi K3
# endpoint accepts 0.6.

DRAWING_VLM_TEMPERATURE=0.6
VLLM_OPENAI_BASE_URL=https://nova.deloitte.com.cn/v1
VLLM_OPENAI_API_KEY=
VLLM_MODEL_NAME=Qwen3.5-VL
DRAWING_OBB_MODEL=Qwen3.5-VL